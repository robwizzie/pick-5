{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pick-5",
	// Custom entry = OpenNext's generated worker + a `scheduled` handler for Cron Triggers.
	"main": "cloudflare/worker.ts",
	"compatibility_date": "2026-09-01",
	// nodejs_compat provides node:net / node:tls / node:dns / node:crypto that the
	// MongoDB driver, next-auth and web-push need.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference required by OpenNext (must match "name" above).
			"binding": "WORKER_SELF_REFERENCE",
			"service": "pick-5"
		}
	],
	// UTC. Both run /api/cron/master, which picks the jobs from the trigger and the time in
	// US Eastern (DST-aware); see src/lib/notifications/schedule.ts, which must list the same
	// two strings, and DEPLOY-CLOUDFLARE.md section 3.
	//  - every 10 min during the hours a game can finish (game-result pushes)
	//  - hourly at :05 (pick reminders, score emails, weekly recap, odds; each runs only in its window)
	"triggers": {
		"crons": ["*/10 0-8,15-23 * * *", "5 * * * *"]
	},
	"observability": {
		"enabled": true
	},
	// Variables and secrets are managed in the dashboard (or `wrangler secret put`);
	// keep_vars stops `wrangler deploy` from wiping dashboard-set plain vars.
	// See DEPLOY-CLOUDFLARE.md for the full list.
	"keep_vars": true
}
